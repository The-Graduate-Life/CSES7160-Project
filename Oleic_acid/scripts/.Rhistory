sink("results/session_info.txt")
cat("CSES 7160 | Fritzner Pierre | Peanut Oleic Acid Analysis\n")
cat("Date:", format(Sys.time(), "%Y-%m-%d %H:%M:%S"), "\n\n")
print(sessionInfo())
}, finally = { sink() })
sessionInfo()
