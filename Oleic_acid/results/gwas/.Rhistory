setwd(PROJECT_DIR); setwd("results/gwas")
gwas_out <- GAPIT(
Y           = pheno_gapit,
GD          = GD,
GM          = GM,
CV          = CV,
model       = "FarmCPU",
PCA.total   = 0,
SNP.MAF     = 0,
file.output = TRUE
)
# Convert your existing K_mat to GAPIT's expected format
# GAPIT wants kinship as a data.frame with Taxa as first column
KI_gapit <- cbind(
data.frame(Taxa = rownames(K_mat)),
as.data.frame(K_mat)
)
# Retry with kinship supplied and output plotting disabled
setwd(PROJECT_DIR); setwd("results/gwas")
gwas_out <- GAPIT(
Y              = pheno_gapit,
GD             = GD,
GM             = GM,
CV             = CV,
KI             = KI_gapit,       # supply pre-built GRM
model          = "FarmCPU",
PCA.total      = 0,
SNP.MAF        = 0,
file.output    = TRUE,
Geno.View.output = FALSE,        # skip genotype view plot
PCA.View.output  = FALSE         # skip PCA plot
)
# ********************************************************
# SNP names
snp_gd <- colnames(GD)[-1]
snp_gm <- GM[,1]
# Find shared SNPs
common_snps <- intersect(snp_gd, snp_gm)
# Filter genotype
GD <- GD[, c("Taxa", common_snps)]
# Filter map
GM <- GM[match(common_snps, GM[,1]), ]
